		Settings.PredictionEnabled = not Settings.PredictionEnabled
		SaveConfig(true)
		pcall(function()
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "4KT Predicción",
				Text = Settings.PredictionEnabled and "PISO ON" or "OFF",
				Duration = 2
			})
		end)
	end
end)

