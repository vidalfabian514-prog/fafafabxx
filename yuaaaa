	local function spawnFloatingDamage(character, amount)
		local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
		if not head then return end
		local bill = Instance.new("BillboardGui")
		bill.Size = UDim2.fromOffset(120, 70)
		bill.StudsOffset = Vector3.new(0, 2.8, 0)
		bill.AlwaysOnTop = true
		bill.Adornee = head
		bill.Parent = dmgGui
		local num = Instance.new("TextLabel")
		num.Size = UDim2.new(1, 0, 0, 40)
		num.BackgroundTransparency = 1
		num.Text = tostring(math.floor(amount + 0.5))
		num.TextColor3 = Color3.fromRGB(255, 170, 40)
		num.Font = Enum.Font.GothamBlack
		num.TextSize = 32
		num.Parent = bill
		local gol = Instance.new("TextLabel")
		gol.Size = UDim2.new(1, 0, 0, 18)
		gol.Position = UDim2.fromOffset(0, 38)
		gol.BackgroundTransparency = 1
		gol.Text = "GOLPE"
		gol.TextColor3 = Color3.fromRGB(255, 255, 255)
		gol.Font = Enum.Font.GothamBold
		gol.TextSize = 13
		gol.Parent = bill
		task.spawn(function()
			local t0 = os.clock()
			while os.clock() - t0 < 0.45 do
				local a = (os.clock() - t0) / 0.45
				bill.StudsOffset = Vector3.new(0, 2.8 + a * 1.2, 0)
				num.TextTransparency = a * 0.9
				gol.TextTransparency = a * 0.9
				task.wait()
			end
			pcall(function() bill:Destroy() end)
		end)
	end

	local lastKey = 0
	RunService.Heartbeat:Connect(function()
		local nowc = os.clock()
		if nowc - lastKey >= 1 then
			lastKey = nowc
			if genv.FourKT_KeyPermanent then
				keyLab.Text = "KEY: PERMANENTE"
				keyLab.TextColor3 = Color3.fromRGB(120, 255, 160)
			elseif type(genv.FourKT_KeyExp) == "number" then
				local left = genv.FourKT_KeyExp - os.time()
				if left <= 0 then
					keyLab.Text = "KEY: EXPIRADA"
					keyLab.TextColor3 = Color3.fromRGB(255, 80, 80)
				else
					local h = math.floor(left / 3600)
					local m = math.floor((left % 3600) / 60)
					local s = math.floor(left % 60)
					if h > 24 * 30 then
						keyLab.Text = "KEY: PERMANENTE"
					elseif h > 0 then
						keyLab.Text = string.format("KEY: %02dh %02dm", h, m)
					else
						keyLab.Text = string.format("KEY: %02dm %02ds", m, s)
					end
					keyLab.TextColor3 = Color3.fromRGB(200, 180, 255)
				end
			else
				keyLab.Text = "KEY: --"
			end
		end

		if DamageTotal > 0 and (nowc - LastHitClock) > RESET_AFTER then
			DamageTotal = 0
			LastHitName = ""
			refreshHUD()
		end

		local origin = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		origin = origin and origin.Position
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl == LocalPlayer then continue end
			local char = pl.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hum or not hrp or hum.Health <= 0 then
				HealthCache[pl] = nil
				continue
			end
			local hp = hum.Health
			local prev = HealthCache[pl]
			if prev and hp < prev then
				local dmg = prev - hp
				if dmg > 0.5 and dmg < 800 then
					local myDamage = false
					if isAimActive and isAimActive() and LockedTargetPlayer == pl then
						myDamage = true
					elseif isAimActive and isAimActive() then
						local center = Camera.ViewportSize / 2
						local sp, on = Camera:WorldToViewportPoint(hrp.Position)
						if on and sp.Z > 0 and (Vector2.new(sp.X, sp.Y) - center).Magnitude <= (Settings.FOV or 200) * 0.85 then
							if not origin or (hrp.Position - origin).Magnitude < 350 then
								myDamage = true
							end
						end
					end
					if myDamage then
						DamageTotal += dmg
						LastHitName = pl.DisplayName or pl.Name
						LastHitClock = nowc
						refreshHUD()
						spawnFloatingDamage(char, dmg)
					end
				end
			end
			HealthCache[pl] = hp
		end
	end)
end)


