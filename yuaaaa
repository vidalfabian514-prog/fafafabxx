	local hideToken = 0
	local function showAlert(weaponName, playerName)
		hideToken += 1
		local token = hideToken
		weaponLab.Text = tostring(weaponName)
		userLab.Text = tostring(playerName)
		card.Visible = true
		task.delay(4.5, function()
			if token == hideToken then
				card.Visible = false
			end
		end)
	end

	local function isLegendary(tool)
		if not tool or not tool:IsA("Tool") then return false end
		local r = tool:GetAttribute("RarityName") or tool:GetAttribute("Rarity")
		if type(r) == "string" then
			local rl = string.lower(r)
			if rl:find("legend") or rl:find("legendaria") or rl == "legendary" then
				return true
			end
		end
		if getAnalyzedInfo then
			local info = getAnalyzedInfo(tool)
			if info and info.Rarity and tostring(info.Rarity):lower():find("legend") then
				return true
			end
		end
		if WeaponRegistry then
			local reg = WeaponRegistry[tool.Name] or WeaponRegistry[string.lower(tool.Name)]
			if reg and reg.Rarity and tostring(reg.Rarity):lower():find("legend") then
				return true
			end
		end
		return false
	end

	local function toolDisplayName(tool)
		if getToolDisplayName then
			local n = getToolDisplayName(tool)
			if n and n ~= "" then return n end
		end
		return tool:GetAttribute("DisplayName") or tool.Name
	end

	local function scanPlayer(pl)
		if pl == LocalPlayer then return end
		local bags = {}
		if pl.Character then table.insert(bags, pl.Character) end
		local bp = pl:FindFirstChild("Backpack")
		if bp then table.insert(bags, bp) end
		for _, bag in ipairs(bags) do
			for _, tool in ipairs(bag:GetChildren()) do
				if tool:IsA("Tool") and isLegendary(tool) then
					local wname = toolDisplayName(tool)
					local key = tostring(pl.UserId) .. "|" .. tostring(wname)
					if not seen[key] then
						seen[key] = true
						showAlert(wname, pl.DisplayName or pl.Name)
					end
				end
			end
		end
	end

	-- escaneo periódico + jugadores nuevos
	task.spawn(function()
		while true do
			for _, pl in ipairs(Players:GetPlayers()) do
				pcall(scanPlayer, pl)
			end
			task.wait(1.2)
		end
	end)

	Players.PlayerAdded:Connect(function(pl)
		task.wait(1.5)
		pcall(scanPlayer, pl)
		pl.CharacterAdded:Connect(function()
			task.wait(1)
			pcall(scanPlayer, pl)
		end)
	end)

	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LocalPlayer then
			pl.CharacterAdded:Connect(function()
				task.wait(1)
				pcall(scanPlayer, pl)
			end)
		end
	end
end)

