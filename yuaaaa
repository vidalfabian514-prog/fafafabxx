local function addSnow(panel)
	if not panel then return end
	pcall(function()
		local flakes = {}
		for i = 1, 12 do
			local lab = Instance.new("TextLabel")
			lab.BackgroundTransparency = 1
			lab.Text = "❄"
			lab.TextSize = math.random(10, 15)
			lab.TextColor3 = Color3.fromRGB(200, 230, 255)
			lab.TextTransparency = 0.3
			lab.Size = UDim2.fromOffset(14, 14)
			lab.ZIndex = 3
			lab.Parent = panel
			flakes[i] = { Label = lab, X = math.random(0, 300), Y = math.random(-30, 180), Speed = 0.5 + math.random() * 0.7, Drift = (math.random() - 0.5) * 0.5 }
		end
		RunService.RenderStepped:Connect(function(dt)
			if not panel.Parent or not panel.Visible then return end
			for _, s in ipairs(flakes) do
				s.Y += s.Speed * 45 * dt
				s.X += s.Drift * 18 * dt
				if s.Y > panel.AbsoluteSize.Y + 16 then s.Y = -16 s.X = math.random(0, 300) end
				s.Label.Position = UDim2.fromOffset(s.X, s.Y)
			end
		end)
	end)
end

