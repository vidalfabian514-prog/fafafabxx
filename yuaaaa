local function invNormalizeImage(id)
	if id == nil then return "rbxassetid://7072725737" end
	if type(id) == "number" then return "rbxassetid://" .. tostring(id) end
	if type(id) == "string" then
		if id == "" then return "rbxassetid://7072725737" end
		if id:find("rbxassetid://") or id:find("http") then return id end
		if tonumber(id) then return "rbxassetid://" .. id end
		return id
	end
	return "rbxassetid://7072725737"
end

local function getInventoryItemKey(tool)
	if not tool then return nil end
	local handle = tool:FindFirstChild("Handle")
	local rarity = tool:GetAttribute("RarityName") or tool:GetAttribute("Rarity") or "Common"
	if handle then
		local sm = handle:FindFirstChildOfClass("SpecialMesh")
		if sm and sm.MeshId ~= "" then
			return sm.MeshId .. (sm.TextureId or "") .. "_RARITY_" .. rarity
		end
		if handle:IsA("MeshPart") and handle.MeshId ~= "" then
			return handle.MeshId .. (handle.TextureID or "") .. "_RARITY_" .. rarity
		end
	end
	local itemId = tool:GetAttribute("ItemId") or tool:GetAttribute("Id")
	if itemId and tostring(itemId) ~= "" and tostring(itemId) ~= tool.Name then
		return "ITEMID_" .. tostring(itemId) .. "_RARITY_" .. rarity
	end
	local dn = tool:GetAttribute("DisplayName") or tool.Name
	return "NAME_" .. tostring(dn) .. "_" .. tool.Name .. "_RARITY_" .. rarity
end

local function registerInventoryItems()
	InventoryRegistry = {}
	local items = ReplicatedStorage:FindFirstChild("Items")
	if not items then return end
	for _, folder in ipairs(items:GetChildren()) do
		if folder:IsA("Folder") then
			for _, tool in ipairs(folder:GetChildren()) do
				if tool:IsA("Tool") then
					local key = getInventoryItemKey(tool)
					if key then
						local img = tool:GetAttribute("ImageId") or tool:GetAttribute("Icon") or tool:GetAttribute("Texture")
						InventoryRegistry[key] = {
							Name = tool:GetAttribute("DisplayName") or tool.Name,
							Rarity = tool:GetAttribute("RarityName") or tool:GetAttribute("Rarity") or "Common",
							ImageId = invNormalizeImage(img),
							ToolName = tool.Name,
						}
					end
				end
			end
		end
	end
end
