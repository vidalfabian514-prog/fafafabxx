local function toB36(n)
	local d = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	n = math.floor(tonumber(n) or 0)
	if n <= 0 then return "0" end
	local t = {}
	while n > 0 do
		local r = n % 36
		table.insert(t, 1, d:sub(r + 1, r + 1))
		n = math.floor(n / 36)
	end
	return table.concat(t)
end

local function fromB36(s)
	if type(s) ~= "string" then return nil end
	s = string.upper(s)
	local d = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	local n = 0
	for i = 1, #s do
		local v = d:find(s:sub(i, i), 1, true)
		if not v then return nil end
		n = n * 36 + (v - 1)
	end
	return n
end

local function keyChecksum4(exp)
	local s = tostring(exp) .. KEY_SECRET
	local h = 0
	for i = 1, #s do
		h = (h * 33 + string.byte(s, i)) % 2147483647
	end
	local c = toB36(h % (36 * 36 * 36 * 36)) -- 4 chars
	while #c < 4 do c = "0" .. c end
	return string.upper(c)
end

local KEY_BIND_FILE = "FourKT_KeyBinds.json"

local function loadKeyBinds()
	local ok, data = pcall(function()
		local rf = readfile or (getgenv and getgenv().readfile)
		local isf = isfile or (getgenv and getgenv().isfile)
		if type(isf) == "function" and type(rf) == "function" and isf(KEY_BIND_FILE) then
			return HttpService:JSONDecode(rf(KEY_BIND_FILE))
		end
		return {}
	end)
	if ok and type(data) == "table" then return data end
	return {}
end

local function saveKeyBinds(tbl)
	local wf = writefile or (getgenv and getgenv().writefile)
	if type(wf) ~= "function" then return false end
	return pcall(function()
		wf(KEY_BIND_FILE, HttpService:JSONEncode(tbl))
	end)
end

local function validateKey(key)
	if type(key) ~= "string" then
		return false, "Key incorrecta"
	end
	key = key:gsub("%s+", ""):upper():gsub("4KT%-", "")
	if KEY_BLACKLIST[key] then
		return false, "Key bloqueada"
	end
	local a, b = key:match("^([0-9A-Z]+)%-([0-9A-Z]+)$")
	if not a or not b then
		return false, "Key incorrecta"
	end
	local keyIdEarly = a and b and (a .. "-" .. b) or key
	if KEY_BLACKLIST[keyIdEarly] then
		return false, "Key bloqueada"
	end
	local rel = fromB36(a)
	if not rel then
		return false, "Key incorrecta"
	end
	local exp = rel + KEY_EPOCH
	if os.time() > exp then
		return false, "Key expirada"
	end
	if keyChecksum4(exp) ~= b then
		return false, "Key incorrecta"
	end

	-- Vincular key al PRIMER usuario que la use
	local keyId = a .. "-" .. b
	local uid = tostring(LocalPlayer.UserId)
	local binds = loadKeyBinds()
	local owner = binds[keyId]
	if owner == nil then
		binds[keyId] = {
			userId = uid,
			name = LocalPlayer.Name,
			boundAt = os.time(),
		}
		saveKeyBinds(binds)
	elseif tostring(owner) == uid or (type(owner) == "table" and tostring(owner.userId) == uid) then
		-- mismo usuario: ok
	else
		local other = type(owner) == "table" and (owner.name or owner.userId) or tostring(owner)
		return false, "Key ya usada por otro (" .. tostring(other) .. ")"
	end

	return true, exp
end

