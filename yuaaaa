local function getInventoryWeaponInfo(tool)
	if not tool or not tool:IsA("Tool") then return nil end
	local key = getInventoryItemKey(tool)
	if key and InventoryRegistry[key] then return InventoryRegistry[key] end
	-- fallback: construir al vuelo
	local rarity = tool:GetAttribute("RarityName") or tool:GetAttribute("Rarity") or "Common"
	local img = tool:GetAttribute("ImageId") or tool:GetAttribute("Icon") or tool:GetAttribute("Texture")
	if not img then
		local handle = tool:FindFirstChild("Handle")
		if handle then
			if handle:IsA("MeshPart") and handle.TextureID ~= "" then img = handle.TextureID end
			local sm = handle and handle:FindFirstChildOfClass("SpecialMesh")
			if sm and sm.TextureId ~= "" then img = sm.TextureId end
		end
	end
	local name = tool:GetAttribute("DisplayName") or tool:GetAttribute("Name")
	if not name or tonumber(tostring(name)) then
		local reg = getWeaponRegistryInfo and getWeaponRegistryInfo(tool)
		if reg and reg.Name and not tonumber(tostring(reg.Name)) then name = reg.Name end
	end
	if not name or tonumber(tostring(name)) then
		if tool.Name and not tonumber(tool.Name) then name = tool.Name else name = nil end
	end
	if not name then return nil end
	local low = string.lower(tostring(name))
	if low:find("fist") or low:find("puño") or low:find("puno") then return nil end
	return {
		Name = tostring(name),
		Rarity = rarity,
		ImageId = invNormalizeImage(img),
		ToolName = tool.Name,
	}
end

